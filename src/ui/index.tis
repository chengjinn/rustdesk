function watch_trust() {
    var trusted = handler.is_process_trusted(false);
    var el = $(div#trust-me-box);
    if (el) {
        el.style.set { display: trusted ? "none" : "block" };
    }
    if (!trusted) self.timer(1s, watch_trust);
}

function watch_screen_recording() {
    var trusted = handler.is_can_screen_recording(false);
    var el = $(div#screen-recording-box);
    if (el) {
        el.style.set { display: trusted ? "none" : "block" };
    }
    if (!trusted) self.timer(1s, watch_screen_recording());
}

function formatId(id) {
    id = id.replace(/\s/g, "");
    if (/^\d+$/.test(id) && id.length > 3) {
        var n = id.length;
        var a = n % 3 || 3;
        var new_id = id.substr(0, a);
        for (var i = a; i < n; i += 3) {
            new_id += " " + id.substr(i, 3);
        }
        return new_id;
    }
    return id;
}

event keydown (evt) {
    if (view.focus && view.focus.id != 'remote_id') return;
    if (isEnterKey(evt)) {
        var el = $(button#connect);
        view.focus = el;
        el.sendEvent("click");
    }
}

$(body).content(<div style="size:*"><App /><div #msgbox /></div>);

event click $(#powered-by) {
    handler.open_url("https://rustdesk.com");
}

function self.closing() {
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    handler.closing(x, y, w, h);
    return true;
}

function self.ready() {
    var r = handler.get_size();
    centerize(scaleIt(800), scaleIt(600));
    if (!handler.get_remote_id()) {
        view.focus = $(#remote_id);
    }
}

function checkConnectStatus() {
    self.timer(1s, function() {
        var tmp = handler.get_connect_status();
        if (tmp[0] != connect_status || tmp[1] != key_confirmed) {
            connect_status = tmp[0];
            key_confirmed = tmp[1];
            app.update();
        }
        system_error = handler.get_error();
        checkConnectStatus();
    });
}

checkConnectStatus();